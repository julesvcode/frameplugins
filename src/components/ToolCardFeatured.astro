---
import { Image } from "astro:assets";
import Tag from "./Tag.astro";
import type { CollectionEntry } from "astro:content";
import FeaturedTag from "./FeaturedTag.astro";

type Props = {
  plugins: CollectionEntry<"plugins">;
};

const { plugins } = Astro.props;
const { thumbnailImage, thumbnailAlt, title, description, categories, feat } =
  plugins.data;

const categoryDisplay = categories[0].replace(/-/g, " ");
---

<a
  href={`/plugins/${plugins.slug}`}
  class="relative flex flex-col sm:flex-row gap-6 group overflow-hidden p-6 rounded-lg bg-zinc-100 border border-zinc-200 w-full cursor-pointer hover:border-zinc-300 hover:bg-opacity-80"
>
  <div
    class="flex-shrink-0 w-full sm:w-64 aspect-video rounded-md overflow-hidden border border-zinc-200"
  >
    <Image
      src={thumbnailImage}
      alt={thumbnailAlt}
      class="w-full h-full object-cover"
    />
  </div>
  <div class="flex flex-col gap-2 w-full justify-center">
    <div class="flex items-center gap-2 justify-between">
      <h3 class="text-zinc-950 font-bold leading-8 truncate text-ellipsis">
        {title}
      </h3>
      <Tag category={categoryDisplay} />
    </div>
    <p class="text-zinc-700 text-base leading-7 line-clamp-2">
      {description}
    </p>
  </div>
  {feat && <FeaturedTag />}
</a>
